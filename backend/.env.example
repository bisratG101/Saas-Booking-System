# Application
PORT=4000
NODE_ENV=development

# CORS
# Comma-separated list of allowed frontend origins (e.g. http://localhost:5173,https://my-app.vercel.app)
CORS_ORIGIN=http://localhost:5173

# Database (Neon PostgreSQL connection string)
# Will be used in Increment 2
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication & Security
# Will be used when Auth module is implemented
JWT_SECRET=replace-with-a-secure-random-32-byte-secret-for-production
JWT_EXPIRES_IN=1h
